# App
APP_NAME=Algero API
APP_ENV=local
DEBUG=true

# Database (PostgreSQL in production; SQLite for quick local dev)
# Postgres example: postgresql+asyncpg://algero:algero@localhost:5432/algero
DATABASE_URL=sqlite+aiosqlite:///./algero.db

# JWT auth (replaces Laravel Sanctum)
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS — comma separated origins for the React frontend
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# reCAPTCHA (v2). Leave empty to skip verification (dev/staging).
RECAPTCHA_SECRET=

# Image uploads
UPLOAD_DIR=storage/uploads
PUBLIC_BASE_URL=http://localhost:8000
