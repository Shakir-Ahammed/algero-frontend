# ────────────────────────────────────────────────────────────
# Algero Platform — Root Environment Configuration
# Copy this file to .env and adjust values for your environment
# ────────────────────────────────────────────────────────────

# ─── Application ───────────────────────────────────────────
APP_NAME=Algero
APP_ENV=local
APP_DEBUG=true

# ─── Ports ────────────────────────────────────────────────
BACKEND_PORT=8000
FRONTEND_PORT=3000

# ─── URLs (how the services see each other) ───────────────
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
VITE_API_URL=http://localhost:8000

# ─── PostgreSQL ───────────────────────────────────────────
POSTGRES_DB=algero
POSTGRES_USER=algero
POSTGRES_PASSWORD=algero_secret

# ─── FastAPI Backend ─────────────────────────────────────
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ─── CORS (comma-separated origins) ──────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── Admin Credentials (seeder) ──────────────────────────
ADMIN_EMAIL=admin@algero.com
ADMIN_PASSWORD=password

# ─── Google reCAPTCHA v2 ─────────────────────────────────
RECAPTCHA_SITE_KEY=6LdE8RgtAAAAAFmyZ_N5W__JBq21WkawDR_pypCG
RECAPTCHA_SECRET_KEY=6LdE8RgtAAAAAI8pUjulY1jFqJGmqtaXGs9f8_RJ
VITE_RECAPTCHA_SITE_KEY=6LdE8RgtAAAAAFmyZ_N5W__JBq21WkawDR_pypCG
